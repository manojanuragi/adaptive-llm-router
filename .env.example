# Copy to .env and fill in, or export these directly in your shell.

# Frontier (Tier 2) transport — "cli" (default, shells out to the `claude`
# CLI) or "api" (raw Anthropic Messages API). See README "Two ways to run
# Tier 2". Both ANTHROPIC_API_KEY and CLAUDE_CODE_OAUTH_TOKEN are optional
# — pick whichever auth path matches how you want to be billed:
# ALR_FRONTIER_TRANSPORT=cli

# Option A (interactive dev machine): run `claude login` once — no env
# var needed at all, the CLI transport just uses that session.

# Option B (headless CLI — Docker/CI — billed against your existing
# Claude Pro/Max subscription, not raw API usage): run `claude
# setup-token` once and put the printed token here. Still uses the
# default "cli" transport above.
# CLAUDE_CODE_OAUTH_TOKEN=...

# Option C (headless raw API — billed as API usage): requires
# ALR_FRONTIER_TRANSPORT=api.
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama endpoint / model are configured in alr/config/models.yaml,
# not here — edit that file if your local model or port differs.

# Trace store (every task/cost/savings/caller record) — optional. Unset
# uses a local SQLite file (alr_traces.db); set this to a Postgres DSN to
# store it in the cloud instead — see README "Cloud trace store (free
# tier)". Neon (neon.tech) has a genuinely free permanent tier (no credit
# card, no time limit) that works here with zero code changes.
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
