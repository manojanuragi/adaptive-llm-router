# Copy to .env and fill in, or export these directly in your shell.

# Only needed if alr/frontier_llm.py is swapped back to the raw
# Messages-API connector (e.g. for Docker/k8s deployment). The default
# connector shells out to the `claude` CLI and reuses your existing
# `claude login` session instead — no key needed for local dev.
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama endpoint / model are configured in alr/config/models.yaml,
# not here — edit that file if your local model or port differs.
