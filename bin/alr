#!/usr/bin/env bash
# Thin wrapper so `alr "some task"` works from anywhere, the same way
# `claude "some task"` does — without typing the full
# `python3 /path/to/alr_cli.py` invocation every time.
#
# Installed via SETUP.md's "Give it a short command name" step. Resolves
# the repo root relative to this script's own location, so it works no
# matter where your shell's current directory is.
set -euo pipefail

# Resolve through symlinks (e.g. ~/.local/bin/alr -> this file) to find
# the real repo location — a naive `dirname "${BASH_SOURCE[0]}"` would
# resolve to the symlink's own directory instead.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
    PYTHON="$REPO_ROOT/.venv/bin/python"
else
    PYTHON="python3"
fi

exec "$PYTHON" "$REPO_ROOT/alr_cli.py" "$@"
